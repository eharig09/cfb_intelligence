# Flask runtime
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
REGISTER_LEGACY_DASHBOARDS=1

# College Football Data (https://collegefootballdata.com)
CFBD_API_KEY=
CFB_DEFAULT_SEASON=2026
CFB_DATABASE_PATH=instance/cfb.sqlite3
CFBD_RAW_CACHE_PATH=instance/cfbd_raw
CFB_DISPLAY_TIMEZONE=America/New_York

# Legacy social integrations
BLUESKY_USERNAME=
BLUESKY_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sports-news-aggregator/1.0
# Either name works; YOUTUBE_API_KEY takes precedence.
YOUTUBE_API_KEY=

# Legacy Reds integrations
ATHLETIC_COOKIES=
REDS_SEASON_MODE=auto

# --- Secondary structured sources ---
# SportsDataverse (ESPN FPI, rosters, box scores) and Open-Meteo (kickoff
# weather) need no credentials. They are rate-limited and cached on disk.
#
# Optional: a commercial odds provider. The application works without it and
# already reads betting lines from CFBD, so leave this blank unless a paid plan
# is genuinely wanted.
ODDS_API_KEY=
